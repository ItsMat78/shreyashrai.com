---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getIssueEntries, getIssuePieces } from '../../lib/content';

const issues = await getIssueEntries();

// Each row shows how many pieces the issue gathers, resolved the same way the
// issue page resolves them (so a dropped ref isn't counted).
const rows = await Promise.all(
  issues.map(async (issue) => ({
    issue,
    pieces: await getIssuePieces(issue.data.entries),
  })),
);

const heading = [
  { text: 'Printed', size: 'l', weight: 380, italic: true, rot: -2, shift: '2.5rem' },
  { text: 'issues', size: 'xl', weight: 640, rot: 1.3, lift: '-2.1rem' },
] as const;
---

<Base
  title="Issues"
  description="Hand-picked reading orders from the archive, set as one continuous spread and made to be printed."
>
  <PageHeader eyebrow="The zine" lines={heading}>
    <p class="masthead__deck">
      Every so often I gather a few pieces into a reading order and set them as
      one spread. Made for the browser, but really made for
      <kbd>Ctrl</kbd>+<kbd>P</kbd>.
    </p>
  </PageHeader>

  {
    rows.length === 0 ? (
      <p class="annotation">No issues set yet.</p>
    ) : (
      <ol class="issue-list">
        {rows.map(({ issue, pieces }) => (
          <li class="issue-row">
            <div class="issue-row__lead">
              <span class="issue-row__num">
                {String(issue.data.number).padStart(2, '0')}
              </span>
              <h2 class="display issue-row__title">
                <a class="issue-row__link" href={`/issues/${issue.id}/`}>
                  {issue.data.title}
                </a>
              </h2>
            </div>
            <div class="issue-row__body">
              {issue.data.blurb && <p class="issue-row__blurb">{issue.data.blurb}</p>}
              <p class="annotation issue-row__meta">
                <FormattedDate date={issue.data.date} />
                <span aria-hidden="true"> · </span>
                {pieces.length} {pieces.length === 1 ? 'piece' : 'pieces'}
              </p>
              <ul class="issue-row__contents annotation">
                {pieces.map((p) => (
                  <li>{p.title}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</Base>
