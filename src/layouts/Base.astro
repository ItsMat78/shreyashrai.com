---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  // Absolute site path to a share card (e.g. /og/blog/foo.png). Defaults to
  // the site card in BaseHead when omitted.
  ogImage?: string;
}

const { title, description, type, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} type={type} ogImage={ogImage} />
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
        if (!blocks.length) return;
        blocks.forEach((pre) => {
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = pre.textContent;
          pre.replaceWith(div);
        });
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        import('mermaid').then((m) => {
          m.default.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default' });
          m.default.run();
        });
      });
    </script>
  </head>
  <body>
    <div class="site">
      <Header />
      <main>
        <div class="container">
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <script>
      // All client behaviour lives here in ONE module (executed once) so it
      // survives Astro View Transitions: listeners are bound to `document` and
      // to the transition lifecycle rather than to per-page elements.

      const COPY_ICON =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const CHECK_ICON =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg>';

      // Copy-to-clipboard on every code block. Idempotent: skips any <pre> that
      // is already wrapped, so it can safely re-run after each navigation.
      function initCopyButtons() {
        for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
          if (pre.closest('.code-wrap')) continue;
          const wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          pre.parentNode?.insertBefore(wrap, pre);
          wrap.appendChild(pre);

          const btn = document.createElement('button');
          btn.className = 'code-copy';
          btn.type = 'button';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY_ICON;
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code') as HTMLElement | null;
            const text = code?.innerText ?? pre.innerText;
            try {
              await navigator.clipboard.writeText(text);
              btn.innerHTML = CHECK_ICON;
              btn.classList.add('code-copy--done');
              setTimeout(() => {
                btn.innerHTML = COPY_ICON;
                btn.classList.remove('code-copy--done');
              }, 1800);
            } catch {
              /* clipboard unavailable (http, old browser): do nothing */
            }
          });
          wrap.appendChild(btn);
        }
      }

      // Loading skeleton: wrap each content image/video in a .media-frame that
      // shows the tetromino cube until the file loads (or errors), then fades the
      // media in. Idempotent (skips already-wrapped) so it re-runs after every
      // navigation. Only figure-row thumbnails are left alone — they're too
      // small for the cube and already sit on their own framed plate.
      const TETROMINO =
        '<span class="tetrominos" aria-hidden="true">' +
        '<span class="tetromino box1"></span>' +
        '<span class="tetromino box2"></span>' +
        '<span class="tetromino box3"></span>' +
        '<span class="tetromino box4"></span>' +
        '</span>';

      function initMediaSkeletons() {
        const media = document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
          '.prose img, .prose video',
        );
        for (const el of media) {
          if (el.closest('.media-frame') || el.closest('.figure-row')) continue;

          const frame = document.createElement('span');
          frame.className = 'media-frame';
          // A float belongs on the wrapper so text still wraps past a loading
          // img-left / img-right; the media itself then fills the wrapper.
          for (const side of ['img-left', 'img-right']) {
            if (el.classList.contains(side)) {
              frame.classList.add(side);
              el.classList.remove(side);
            }
          }

          el.parentNode?.insertBefore(frame, el);
          frame.appendChild(el);
          frame.insertAdjacentHTML('afterbegin', TETROMINO);

          const done = () => frame.classList.add('is-loaded');
          const img = el instanceof HTMLImageElement ? el : null;
          const vid = el instanceof HTMLVideoElement ? el : null;
          if (img && img.complete && img.naturalWidth > 0) {
            done();
          } else if (vid && vid.readyState >= 2) {
            done();
          } else {
            el.addEventListener('load', done, { once: true });
            el.addEventListener('loadeddata', done, { once: true });
            el.addEventListener('error', done, { once: true });
          }
        }
      }

      // Theme: the inline head script sets [data-theme] before first paint; this
      // re-applies it the instant a new page is swapped in so it never flashes.
      function applyTheme() {
        try {
          const t = localStorage.getItem('theme');
          document.documentElement.dataset.theme =
            t === 'dark' || t === 'light' ? t : 'light';
        } catch {
          /* localStorage blocked: leave whatever is already set */
        }
      }

      // Keep the toggle's icon/label in sync with the current theme.
      function syncToggle() {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const icon = btn.querySelector('.theme-toggle__icon');
        const dark = document.documentElement.dataset.theme === 'dark';
        if (icon) icon.textContent = dark ? '☀' : '☾';
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
      }

      // Delegated click: one listener on document survives every page swap.
      document.addEventListener('click', (e) => {
        const target = e.target;
        const btn = target instanceof Element ? target.closest('#theme-toggle') : null;
        if (!btn) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
        syncToggle();
      });

      // Rail dropdowns (TOC + series): collapsed on phones, forced open on the
      // wide sticky rail. The per-component inline script handles first paint;
      // this keeps them in sync across navigations and viewport changes.
      const wideRail = window.matchMedia('(min-width: 72rem)');
      function syncRail() {
        for (const d of document.querySelectorAll<HTMLDetailsElement>('.rail details')) {
          d.open = wideRail.matches;
        }
      }
      wideRail.addEventListener('change', syncRail);

      // Contents scroll-spy: highlight the TOC entry for the section being read.
      // State is rebuilt on every navigation (initTocSpy) while the scroll/resize
      // listeners are bound ONCE below and always read the latest state — so it
      // keeps working after client-side page swaps, not just the first load.
      let spyLinks = new Map<string, HTMLAnchorElement>();
      let spyHeadings: HTMLElement[] = [];
      let spyCurrent = '';
      const SPY_OFFSET = 96; // clears the sticky header

      function initTocSpy() {
        spyLinks = new Map();
        spyHeadings = [];
        spyCurrent = '';
        const toc = document.querySelector('.toc');
        if (!toc) return;
        toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          spyLinks.set(decodeURIComponent(a.hash.slice(1)), a);
        });
        spyHeadings = [...spyLinks.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        updateTocSpy();
      }

      function updateTocSpy() {
        if (!spyHeadings.length) return;
        // The active heading is the last one whose top has scrolled above the
        // line just under the sticky header — robust to fast scrolls and gaps.
        let activeId = spyHeadings[0].id;
        for (const h of spyHeadings) {
          if (h.getBoundingClientRect().top <= SPY_OFFSET) activeId = h.id;
          else break;
        }
        if (activeId === spyCurrent) return;
        spyCurrent = activeId;
        spyLinks.forEach((a, key) => {
          const on = key === activeId;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }

      let spyTicking = false;
      function onSpyScroll() {
        if (spyTicking) return;
        spyTicking = true;
        requestAnimationFrame(() => {
          updateTocSpy();
          spyTicking = false;
        });
      }
      window.addEventListener('scroll', onSpyScroll, { passive: true });
      window.addEventListener('resize', onSpyScroll, { passive: true });

      // Search (Pagefind): the bundle only exists in the BUILT site, so it's
      // injected on demand the first time /search is shown and the UI is mounted
      // on every navigation there (the #search node is fresh after each swap).
      // This is why reaching /search via an in-site link now works — the old
      // DOMContentLoaded init never re-fired after a View Transition.
      let pagefindJs: Promise<boolean> | null = null;
      function loadPagefindJs(): Promise<boolean> {
        if (pagefindJs) return pagefindJs;
        pagefindJs = new Promise((resolve) => {
          if ((window as any).PagefindUI) return resolve(true);
          const s = document.createElement('script');
          s.src = '/pagefind/pagefind-ui.js';
          s.onload = () => resolve(true);
          s.onerror = () => resolve(false); // dev / no index built yet
          document.head.appendChild(s);
        });
        return pagefindJs;
      }

      function initSearch() {
        const mount = document.getElementById('search');
        if (!mount || mount.dataset.ready) return;
        // Pagefind's stylesheet is dropped from <head> when navigating away;
        // re-add it whenever the search page is shown.
        if (!document.querySelector('link[data-pagefind-css]')) {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = '/pagefind/pagefind-ui.css';
          css.setAttribute('data-pagefind-css', '');
          document.head.appendChild(css);
        }
        loadPagefindJs().then((ok) => {
          if (mount.dataset.ready) return;
          const UI = (window as any).PagefindUI;
          if (!ok || typeof UI === 'undefined') {
            mount.innerHTML =
              '<p class="search-missing annotation">Search runs on the built site. Locally, run <code>npm run build</code> then <code>npm run preview</code>.</p>';
            return;
          }
          mount.dataset.ready = '1';
          new UI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
        });
      }

      // When a series index is capped and scrolls inside itself (a long series on
      // a stacked layout), bring the current part into view within its own box so
      // the reader lands in place rather than at the top of a scrolled list. Only
      // touches lists that actually overflow, and only their own scrollTop — never
      // the page.
      function alignSeriesCurrent() {
        for (const list of document.querySelectorAll<HTMLElement>('.series__list')) {
          if (list.scrollHeight <= list.clientHeight + 4) continue;
          const cur = list.querySelector<HTMLElement>('.series__item--current');
          if (!cur) continue;
          const offset =
            cur.getBoundingClientRect().top - list.getBoundingClientRect().top + list.scrollTop;
          list.scrollTop = offset - list.clientHeight / 2 + cur.offsetHeight / 2;
        }
      }

      // Lightbox: click a content image to see it enlarged over a dark scrim.
      // Decorative masthead/project art lives outside .prose (untouched); linked
      // images keep their link. Delegated to document, so it needs no per-image
      // wiring and survives View Transitions — the overlay node itself is
      // re-attached on page-load since a swap discards body children.
      let lbOpener: HTMLElement | null = null;

      function ensureLightbox() {
        let overlay = document.getElementById('lightbox');
        if (overlay) return overlay;
        overlay = document.createElement('div');
        overlay.id = 'lightbox';
        overlay.className = 'lightbox';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.innerHTML =
          '<img class="lightbox__img" alt="" />' +
          '<button type="button" class="lightbox__close" aria-label="Close image">' +
          '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>' +
          '</button>';
        overlay.addEventListener('click', closeLightbox);
        document.body.appendChild(overlay);
        return overlay;
      }

      function openLightbox(img: HTMLImageElement) {
        const overlay = ensureLightbox();
        const big = overlay.querySelector('img') as HTMLImageElement;
        big.src = img.currentSrc || img.src;
        big.alt = img.alt || '';
        lbOpener = img;
        requestAnimationFrame(() => overlay.classList.add('is-open'));
        document.documentElement.classList.add('lightbox-open');
        (overlay.querySelector('.lightbox__close') as HTMLElement | null)?.focus();
      }

      function closeLightbox() {
        const overlay = document.getElementById('lightbox');
        document.documentElement.classList.remove('lightbox-open');
        if (overlay) overlay.classList.remove('is-open');
        lbOpener?.focus?.();
        lbOpener = null;
      }

      // Open on a plain content image; skip linked images (follow the link) and
      // the overlay's own image.
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof HTMLImageElement)) return;
        if (t.closest('.lightbox') || t.closest('a') || !t.closest('.prose')) return;
        openLightbox(t);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
        // "/" anywhere (outside a field) jumps into the search box.
        if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
          const t = e.target as HTMLElement | null;
          const tag = t?.tagName ?? '';
          if (/^(INPUT|TEXTAREA|SELECT)$/.test(tag) || t?.isContentEditable) return;
          const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
          if (input) {
            e.preventDefault();
            input.focus();
          }
        }
      });

      // ---- /map: highlight a node's neighbourhood ---------------------------
      // The constellation itself is built at BUILD time (lib/graph.ts) and
      // shipped as static SVG; this only dims what a hovered/focused dot is not
      // connected to. Bound per page-load because the <svg> node is fresh after
      // every View Transition swap.
      function initGraph() {
        const svg = document.querySelector<SVGSVGElement>('#graph');
        if (!svg || svg.dataset.ready) return;
        svg.dataset.ready = '1';

        const nodes = [...svg.querySelectorAll<SVGGElement>('.graph__node')];
        const edges = [...svg.querySelectorAll<SVGLineElement>('.graph__edge')];

        const neighbours = new Map<string, Set<string>>();
        for (const e of edges) {
          const a = e.dataset.a;
          const b = e.dataset.b;
          if (!a || !b) continue;
          if (!neighbours.has(a)) neighbours.set(a, new Set());
          if (!neighbours.has(b)) neighbours.set(b, new Set());
          neighbours.get(a)!.add(b);
          neighbours.get(b)!.add(a);
        }

        function light(id: string) {
          const near = neighbours.get(id) ?? new Set<string>();
          svg!.classList.add('is-focused');
          for (const n of nodes) {
            const nid = n.dataset.id ?? '';
            n.classList.toggle('is-lit', nid === id || near.has(nid));
          }
          for (const e of edges) {
            e.classList.toggle('is-lit', e.dataset.a === id || e.dataset.b === id);
          }
        }

        function clear() {
          svg!.classList.remove('is-focused');
          for (const n of nodes) n.classList.remove('is-lit');
          for (const e of edges) e.classList.remove('is-lit');
        }

        for (const n of nodes) {
          const id = n.dataset.id ?? '';
          n.addEventListener('mouseenter', () => light(id));
          n.addEventListener('focus', () => light(id));
          n.addEventListener('mouseleave', clear);
          n.addEventListener('blur', clear);
        }
      }

      // ---- /type: the Fraunces specimen lab ---------------------------------
      // Drives the four variable axes on one preview line and prints the
      // matching <ScatterHead /> fragment props.
      type TypeState = {
        text: string;
        opsz: number;
        wght: number;
        SOFT: number;
        WONK: number;
        size: number;
        rot: number;
        italic: boolean;
      };

      function initTypeLab() {
        const lab = document.getElementById('type-lab');
        if (!lab || lab.dataset.ready) return;
        lab.dataset.ready = '1';

        const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
        const preview = $<HTMLElement>('type-preview');
        const textInput = $<HTMLInputElement>('type-text');
        if (!preview || !textInput) return;

        const ranges = {
          opsz: $<HTMLInputElement>('type-opsz'),
          wght: $<HTMLInputElement>('type-wght'),
          SOFT: $<HTMLInputElement>('type-SOFT'),
          WONK: $<HTMLInputElement>('type-WONK'),
          size: $<HTMLInputElement>('type-size'),
          rot: $<HTMLInputElement>('type-rot'),
        };
        const italic = $<HTMLInputElement>('type-italic');

        function read(): TypeState {
          return {
            text: textInput!.value || 'Learning out loud',
            opsz: Number(ranges.opsz?.value ?? 144),
            wght: Number(ranges.wght?.value ?? 560),
            SOFT: Number(ranges.SOFT?.value ?? 0),
            WONK: Number(ranges.WONK?.value ?? 0),
            size: Number(ranges.size?.value ?? 96),
            rot: Number(ranges.rot?.value ?? 0),
            italic: italic?.checked ?? false,
          };
        }

        function apply() {
          const s = read();
          preview!.textContent = s.text;
          preview!.style.fontVariationSettings =
            `'opsz' ${s.opsz}, 'wght' ${s.wght}, 'SOFT' ${s.SOFT}, 'WONK' ${s.WONK}`;
          preview!.style.fontSize = `${s.size}px`;
          preview!.style.fontStyle = s.italic ? 'italic' : 'normal';
          preview!.style.transform = `rotate(${s.rot}deg)`;

          for (const [key, el] of Object.entries(ranges)) {
            const out = document.getElementById(`type-${key}-out`);
            if (out && el) out.textContent = el.value;
          }

        }

        for (const el of Object.values(ranges)) el?.addEventListener('input', apply);
        italic?.addEventListener('change', apply);
        textInput.addEventListener('input', apply);

        // Presets carry a whole state as JSON on the button.
        for (const btn of lab.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
          btn.addEventListener('click', () => {
            let p: Partial<TypeState> & { name?: string };
            try {
              p = JSON.parse(btn.dataset.preset ?? '{}');
            } catch {
              return;
            }
            if (p.text !== undefined) textInput.value = p.text;
            for (const key of ['opsz', 'wght', 'SOFT', 'WONK', 'size', 'rot'] as const) {
              const el = ranges[key];
              if (el && p[key] !== undefined) el.value = String(p[key]);
            }
            if (italic) italic.checked = Boolean(p.italic);
            apply();
          });
        }

        apply();
      }

      // ---- /on-this-day: match the archive against the READER's date --------
      // The site is static, so the server-rendered block uses the build date;
      // this replaces it with the visitor's own today.
      type AlmanacItem = {
        title: string;
        url: string;
        kind: string;
        month: number;
        day: number;
        year: number;
      };

      const MONTH_NAMES = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December',
      ];

      function initAlmanac() {
        const holder = document.getElementById('almanac');
        if (!holder || holder.dataset.ready) return;
        const raw = document.getElementById('almanac-data')?.textContent;
        const list = document.getElementById('otd-list');
        const label = document.getElementById('otd-date');
        const note = document.getElementById('otd-note');
        if (!raw || !list || !label) return;

        let items: AlmanacItem[];
        try {
          items = JSON.parse(raw);
        } catch {
          return;
        }
        holder.dataset.ready = '1';

        const now = new Date();
        const month = now.getMonth() + 1;
        const day = now.getDate();
        label.textContent = `${MONTH_NAMES[month - 1]} ${day}`;

        const today = items
          .filter((i) => i.month === month && i.day === day)
          .sort((a, b) => b.year - a.year);

        if (today.length > 0) {
          list.innerHTML =
            '<ul class="otd__list">' +
            today
              .map(
                (i) =>
                  `<li class="otd__item"><span class="annotation otd__year">${i.year}</span>` +
                  `<a class="otd__title" href="${i.url}">${escapeHtml(i.title)}</a>` +
                  `<span class="annotation otd__kind">${i.kind}</span></li>`,
              )
              .join('') +
            '</ul>';
          if (note) note.textContent = `${today.length} from this date in earlier years.`;
          return;
        }

        // Nothing on the exact date: offer the nearest anniversary either side,
        // so the page always hands the reader somewhere to go.
        const distance = (i: AlmanacItem) => {
          const a = new Date(Date.UTC(2000, month - 1, day)).getTime();
          const b = new Date(Date.UTC(2000, i.month - 1, i.day)).getTime();
          const raw = Math.abs(a - b) / 86400000;
          return Math.min(raw, 365 - raw); // the year wraps
        };
        const nearest = [...items].sort((a, b) => distance(a) - distance(b))[0];

        if (nearest) {
          const days = Math.round(distance(nearest));
          list.innerHTML =
            `<p class="annotation otd__empty">Nothing on this exact date. The nearest is ` +
            `<a href="${nearest.url}">${escapeHtml(nearest.title)}</a>, ` +
            `${MONTH_NAMES[nearest.month - 1]} ${nearest.day} ${nearest.year} ` +
            `&mdash; ${days} ${days === 1 ? 'day' : 'days'} away.</p>`;
        } else {
          list.innerHTML = '<p class="annotation otd__empty">Nothing on this date yet.</p>';
        }
        if (note) note.textContent = 'Checked against your device’s calendar.';
      }

      function escapeHtml(s: string): string {
        return s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // ---- /random: throw the reader somewhere ------------------------------
      // `replace` keeps /random out of history, so Back goes where the reader
      // came from instead of bouncing them to another random page.
      function initRandom() {
        const holder = document.getElementById('random');
        if (!holder || holder.dataset.ready) return;
        holder.dataset.ready = '1';
        const raw = document.getElementById('random-data')?.textContent;
        if (!raw) return;
        try {
          const doors: { url: string }[] = JSON.parse(raw);
          if (!doors.length) return;
          const pick = doors[Math.floor(Math.random() * doors.length)];
          window.location.replace(pick.url);
        } catch {
          /* leave the full index on screen */
        }
      }

      // ---- /type: the typing test -------------------------------------------
      // A monkeytype-shaped test running on this site's own prose. The words
      // come from the page as JSON; everything below is clock, scoring, and
      // caret. Scored the way monkeytype scores: net WPM = correctly typed
      // characters / 5 / minutes, so mistakes cost you rather than counting.
      type TypingPara = { text: string; title: string; url: string };

      function initTypingTest() {
        const root = document.getElementById('tt');
        if (!root || root.dataset.ready) return;

        const raw = document.getElementById('tt-data')?.textContent;
        if (!raw) return;
        let paras: TypingPara[];
        try {
          paras = JSON.parse(raw);
        } catch {
          return;
        }
        if (!paras.length) return;
        root.dataset.ready = '1';

        const $ = (id: string) => document.getElementById(id);
        const wordsEl = $('tt-words');
        const viewport = $('tt-viewport');
        const caret = $('tt-caret');
        const input = $('tt-input') as HTMLInputElement | null;
        const stage = $('tt-stage');
        const clock = $('tt-clock');
        const hint = $('tt-hint');
        const results = $('tt-results');
        const sourceEl = $('tt-source');
        if (!wordsEl || !viewport || !caret || !input || !stage || !clock || !results) return;

        let seconds = 15;
        let words: string[] = [];
        let charSpans: HTMLElement[][] = [];
        let wordSpans: HTMLElement[] = [];
        let typed: string[] = [];
        let index = 0;
        let running = false;
        let startedAt = 0;
        let endsAt = 0;
        let ticker: ReturnType<typeof setInterval> | undefined;
        let lineHeight = 0;

        // Accuracy is a measure of KEYPRESSES, not of the text you end up with:
        // a wrong letter you backspace away still happened. These count every
        // character actually pressed, and are never decremented — which is why
        // scoring the final string (the first version of this) read high.
        let keystrokes = 0;
        let keystrokesRight = 0;
        let lastValue = '';
        let typingTimer: ReturnType<typeof setTimeout> | undefined;

        // Enough words that a fast typist can't run out inside 30 seconds, even
        // if the first paragraph is short. Extra paragraphs are credited too.
        function build() {
          const used: TypingPara[] = [];
          const pool = [...paras];
          const picked: string[] = [];
          // 140 words covers a ~250wpm typist for the full 30 seconds; running
          // out mid-test would strand them on the last word.
          while (picked.length < 140 && pool.length) {
            const p = pool.splice(Math.floor(Math.random() * pool.length), 1)[0];
            used.push(p);
            picked.push(...p.text.split(' ').filter(Boolean));
          }
          words = picked;

          if (sourceEl) {
            const first = used[0];
            const extra = used.length - 1;
            sourceEl.innerHTML =
              `From <a href="${first.url}">${escapeHtml(first.title)}</a>` +
              (extra > 0 ? ` +${extra}` : '');
          }
        }

        function render() {
          wordsEl!.innerHTML = '';
          charSpans = [];
          wordSpans = [];
          for (const word of words) {
            const wordEl = document.createElement('span');
            wordEl.className = 'tt-word';
            const chars: HTMLElement[] = [];
            for (const ch of word) {
              const charEl = document.createElement('span');
              charEl.className = 'tt-char';
              charEl.textContent = ch;
              wordEl.appendChild(charEl);
              chars.push(charEl);
            }
            wordsEl!.appendChild(wordEl);
            wordSpans.push(wordEl);
            charSpans.push(chars);
          }
          lineHeight = wordSpans[0]?.offsetHeight ?? 0;
          wordsEl!.style.transform = 'translateY(0)';
        }

        // The caret sits at the current character; the word strip scrolls up a
        // line at a time so the line being typed stays put (monkeytype's trick —
        // the text moves, the reader's eye doesn't).
        function moveCaret() {
          const chars = charSpans[index];
          if (!chars || !chars.length) return;
          const at = Math.min(input!.value.length, chars.length - 1);
          const atEnd = input!.value.length >= chars.length;
          const target = chars[at];
          const x = target.offsetLeft + (atEnd ? target.offsetWidth : 0);
          const y = target.offsetTop;
          caret!.style.transform = `translate(${x}px, ${y}px)`;
          caret!.style.height = `${target.offsetHeight}px`;

          if (lineHeight > 0) {
            const line = Math.round(y / lineHeight);
            const shift = Math.max(0, line - 1) * lineHeight;
            wordsEl!.style.transform = `translateY(${-shift}px)`;
            caret!.style.marginTop = `${-shift}px`;
          }
        }

        function paint() {
          const value = input!.value;
          const target = words[index] ?? '';
          const chars = charSpans[index] ?? [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className =
              'tt-char' +
              (i < value.length ? (value[i] === target[i] ? ' is-right' : ' is-wrong') : '');
          }
          wordSpans[index]?.classList.toggle('has-extra', value.length > target.length);
          moveCaret();
        }

        // A caret that blinks while you're typing is just flicker in your
        // peripheral vision. Hold it solid on every keystroke and let it start
        // blinking again only once you've stopped — the blink is there to find
        // the caret when idle, which is exactly when it's useful.
        function markTyping() {
          stage!.classList.add('is-typing');
          if (typingTimer) clearTimeout(typingTimer);
          typingTimer = setTimeout(() => stage!.classList.remove('is-typing'), 900);
        }

        function stopTyping() {
          if (typingTimer) clearTimeout(typingTimer);
          typingTimer = undefined;
          stage!.classList.remove('is-typing');
        }

        // Strip a word back to untyped. Needed when backspacing OUT of a word:
        // the colouring it picked up would otherwise stay behind on a word the
        // reader has abandoned.
        function clearWord(i: number) {
          for (const charEl of charSpans[i] ?? []) charEl.className = 'tt-char';
          wordSpans[i]?.classList.remove('has-extra');
        }

        function setActive() {
          for (const w of wordSpans) w.classList.remove('is-active');
          wordSpans[index]?.classList.add('is-active');
        }

        function start() {
          if (running) return;
          running = true;
          // Focus mode: everything that isn't the clock and the words fades out
          // for the duration of the test. Nothing is display:none'd, so the page
          // doesn't reflow underneath the reader mid-word.
          document.documentElement.classList.add('tt-focus');
          startedAt = Date.now();
          endsAt = startedAt + seconds * 1000;
          ticker = setInterval(() => {
            const left = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
            clock!.textContent = String(left);
            if (left <= 0) finish();
          }, 100);
        }

        function finish() {
          if (ticker) clearInterval(ticker);
          ticker = undefined;
          running = false;
          stopTyping();
          document.documentElement.classList.remove('tt-focus');
          // Only record a word still being typed. Assigning unconditionally
          // overwrote the last COMMITTED word with the now-empty input whenever
          // the test ended on a space, silently losing it from the score.
          if (input!.value.length > 0) typed[index] = input!.value;
          // Drop anything past the word the reader is actually on. Backspacing
          // out of a word leaves its old text sitting in the array, and scoring
          // it would credit words that have since been erased.
          typed.length = index + 1;
          input!.disabled = true;
          caret!.hidden = true;

          // WPM is scored on the text as it ended up: a character counts only if
          // it's the right character in the right place, and a committed word
          // earns its trailing space only if the whole word came out right.
          // A word is five characters by the standard convention.
          let correctChars = 0;
          let finalChars = 0;
          for (let i = 0; i < typed.length; i++) {
            const got = typed[i] ?? '';
            const want = words[i] ?? '';
            finalChars += got.length;
            for (let j = 0; j < got.length; j++) if (got[j] === want[j]) correctChars++;
            if (i < typed.length - 1) {
              finalChars += 1;
              if (got === want) correctChars++;
            }
          }

          // Real elapsed time, not the nominal duration: the interval that ends
          // the test can fire a little late, and dividing by the wrong number
          // quietly inflates every score.
          const elapsed = startedAt
            ? Math.min(seconds, (Date.now() - startedAt) / 1000)
            : seconds;
          const minutes = Math.max(elapsed, 1) / 60;

          const wpm = Math.round(correctChars / 5 / minutes);
          const raw = Math.round(keystrokes / 5 / minutes);
          const accuracy =
            keystrokes > 0 ? Math.round((keystrokesRight / keystrokes) * 100) : 0;

          const wpmEl = $('tt-wpm');
          const accEl = $('tt-acc');
          const rawEl = $('tt-raw');
          const verdict = $('tt-verdict');
          if (wpmEl) wpmEl.textContent = String(wpm);
          if (accEl) accEl.textContent = `${accuracy}%`;
          if (rawEl) rawEl.textContent = String(raw);
          if (verdict) {
            verdict.textContent =
              `${correctChars} of ${finalChars} characters correct, from ` +
              `${keystrokes} keystrokes in ${Math.round(elapsed)} seconds. ` +
              'WPM counts only the characters you got right, raw counts every one, ' +
              'and accuracy is per keypress, so a mistake you fixed still counts.';
          }
          results!.hidden = false;
          stage!.classList.add('is-done');
          if (hint) {
            hint.textContent = 'Shift+Enter to go again';
            hint.classList.remove('is-hidden');
          }
        }

        function reset() {
          if (ticker) clearInterval(ticker);
          ticker = undefined;
          running = false;
          stopTyping();
          document.documentElement.classList.remove('tt-focus');
          index = 0;
          typed = [];
          keystrokes = 0;
          keystrokesRight = 0;
          lastValue = '';
          startedAt = 0;
          input!.disabled = false;
          input!.value = '';
          caret!.hidden = false;
          results!.hidden = true;
          stage!.classList.remove('is-done');
          if (hint) {
            hint.textContent = 'Click the words to begin';
            hint.classList.remove('is-hidden');
          }
          clock!.textContent = String(seconds);
          build();
          render();
          setActive();
          paint();
        }

        input.addEventListener('input', () => {
          if (input.disabled) return;
          start();
          markTyping();
          // Count only what was ADDED since the last event: a backspace shrinks
          // the value and must not refund the keystroke it's undoing.
          const value = input.value;
          if (value.length > lastValue.length) {
            const target = words[index] ?? '';
            for (let i = lastValue.length; i < value.length; i++) {
              keystrokes++;
              if (value[i] === target[i]) keystrokesRight++;
            }
          }
          lastValue = value;
          paint();
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            e.preventDefault();
            reset();
            input.focus();
            return;
          }
          // Backspace at the start of a word steps back into the previous one
          // and hands its text back, so a mistake two words ago is still
          // fixable. Ctrl+Backspace clears the current word first, as it does
          // in a text field.
          if (e.key === 'Backspace' && !input.disabled) {
            if (e.ctrlKey && input.value.length > 0) {
              e.preventDefault();
              markTyping();
              input.value = '';
              lastValue = '';
              paint();
              return;
            }
            if (input.value.length === 0 && index > 0) {
              e.preventDefault();
              markTyping();
              clearWord(index);
              typed[index] = '';
              index -= 1;
              input.value = typed[index] ?? '';
              // Restoring text is not typing it: no keystrokes are credited for
              // what the reader already pressed once.
              lastValue = input.value;
              setActive();
              paint();
              return;
            }
          }

          if (e.key === ' ') {
            e.preventDefault();
            if (input.disabled) return;
            // A leading space shouldn't skip a word.
            if (input.value.length === 0) return;
            start();
            markTyping();
            // The space is a keypress too, and it's only the right one when the
            // word it closes came out right.
            keystrokes++;
            if (input.value === words[index]) keystrokesRight++;
            typed[index] = input.value;
            input.value = '';
            lastValue = '';
            // Out of words: the test is over, rather than pinning the reader on
            // the last word while the clock runs down.
            if (index + 1 >= words.length) {
              finish();
              return;
            }
            index += 1;
            setActive();
            paint();
          }
        });

        // The input is invisible and covers the whole stage, so a click anywhere
        // on the words puts the cursor where the reader expects it.
        stage.addEventListener('click', () => input.focus());
        // The hint keeps its space and only goes invisible, so focusing the test
        // doesn't shift the row underneath it.
        input.addEventListener('focus', () => {
          stage.classList.add('is-focused');
          hint?.classList.add('is-hidden');
        });
        input.addEventListener('blur', () => {
          stage.classList.remove('is-focused');
          // Clicking away brings the rest of the page back, even mid-test — the
          // page must never be left stuck in a faded state.
          document.documentElement.classList.remove('tt-focus');
          if (!input.disabled) hint?.classList.remove('is-hidden');
        });

        for (const chip of root.querySelectorAll<HTMLButtonElement>('.tt__chip')) {
          chip.addEventListener('click', () => {
            seconds = Number(chip.dataset.seconds) || 15;
            for (const other of root.querySelectorAll('.tt__chip')) {
              other.classList.toggle('is-on', other === chip);
            }
            reset();
          });
        }

        $('tt-restart')?.addEventListener('click', () => {
          reset();
          input.focus();
        });

        // Shift+Enter restarts from anywhere on the page — the input is disabled
        // once the test ends, so a key handler bound to it alone would be dead
        // exactly when you want to go again.
        document.addEventListener('keydown', (e) => {
          if (!root.isConnected) return;
          if (e.key !== 'Enter' || !e.shiftKey) return;
          const t = e.target as HTMLElement | null;
          const tag = t?.tagName ?? '';
          // Never hijack Shift+Enter inside someone else's field.
          if (t !== input && (/^(INPUT|TEXTAREA|SELECT)$/.test(tag) || t?.isContentEditable)) return;
          e.preventDefault();
          reset();
          input.focus();
        });

        // A resize rewraps the words, so the caret and the line offset have to
        // be recomputed against the new layout.
        window.addEventListener('resize', () => {
          if (!root.isConnected) return;
          lineHeight = wordSpans[0]?.offsetHeight ?? lineHeight;
          paint();
        });

        reset();
      }

      // ---- 404: set the address that was actually asked for -----------------
      // A static host serves one 404.html for every missing path, so the page
      // can only learn the URL here. Text is set with textContent — the path is
      // attacker-controlled, and must never be parsed as markup.
      function init404() {
        const head = document.getElementById('e404');
        if (!head || head.dataset.ready) return;
        head.dataset.ready = '1';

        const line = head.querySelector<HTMLElement>('.scatter__line--xl');
        const path = decodeURIComponent(window.location.pathname).replace(/\/+$/, '');
        if (line && path && path !== '') {
          line.textContent = path.length > 30 ? `${path.slice(0, 29)}…` : path;
        }

        const raw = document.getElementById('e404-data')?.textContent;
        const guess = document.getElementById('e404-guess');
        if (!raw || !guess) return;

        let doors: { title: string; url: string }[];
        try {
          doors = JSON.parse(raw);
        } catch {
          return;
        }

        // Compare the last path segment against every real slug, and suggest
        // the closest one when it's close enough to plausibly be a typo.
        const want = path.split('/').filter(Boolean).pop() ?? '';
        if (!want) return;

        let best: { title: string; url: string; d: number } | null = null;
        for (const door of doors) {
          const slug = door.url.split('/').filter(Boolean).pop() ?? '';
          const titleSlug = door.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          // A half-remembered address ("/projects/lagrange") is a containment
          // match, not a typo — edit distance alone scores it as badly as
          // gibberish. Four characters is the floor, so "til" can't match
          // everything it happens to be a substring of.
          const contained =
            want.length >= 4 &&
            (slug.includes(want) ||
              want.includes(slug) ||
              titleSlug.includes(want) ||
              want.includes(titleSlug));
          const d = contained
            ? 0
            : Math.min(editDistance(want, slug), editDistance(want, titleSlug));
          if (!best || d < best.d) best = { ...door, d };
        }

        const tolerance = Math.max(3, Math.floor(want.length * 0.5));
        if (best && best.d <= tolerance) {
          guess.innerHTML = `Did you mean <a href="${best.url}">${escapeHtml(best.title)}</a>?`;
          guess.hidden = false;
        }
      }

      // Levenshtein, two-row variant — enough for one short slug against a few
      // dozen others.
      function editDistance(a: string, b: string): number {
        if (a === b) return 0;
        if (!a.length || !b.length) return Math.max(a.length, b.length);
        let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
        for (let i = 1; i <= a.length; i++) {
          const row = [i];
          for (let j = 1; j <= b.length; j++) {
            row[j] = Math.min(
              prev[j] + 1,
              row[j - 1] + 1,
              prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1),
            );
          }
          prev = row;
        }
        return prev[b.length];
      }

      // Print button (the zine issues). Delegated, so it survives swaps.
      document.addEventListener('click', (e) => {
        const t = e.target;
        const btn = t instanceof Element ? t.closest('[data-print]') : null;
        if (btn) window.print();
      });

      // Re-apply the saved theme pre-paint on every transition (no flash).
      document.addEventListener('astro:after-swap', applyTheme);

      // Fires on the initial load AND after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        syncToggle();
        initCopyButtons();
        initMediaSkeletons();
        ensureLightbox();
        // A navigation while the lightbox was open discards the overlay; make
        // sure the scroll lock never survives into the next page. Same for the
        // typing test's focus mode, which lives on <html> and would otherwise
        // leave the next page faded out.
        document.documentElement.classList.remove('lightbox-open');
        document.documentElement.classList.remove('tt-focus');
        syncRail();
        initTocSpy();
        initSearch();
        alignSeriesCurrent();
        initGraph();
        initTypeLab();
        initAlmanac();
        initRandom();
        init404();
        initTypingTest();
      });
    </script>
  </body>
</html>
